# ==============================================================================
# IRCbot / Telegram LLM Bot — Environment Configuration
# ==============================================================================

# [الزامی] توکن ربات تلگرام دریافت‌شده از @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# [Ollama] آدرس سرویس لوکال Ollama
# اگر روی هاست اجرا می‌کنید: http://127.0.0.1:11434
# اگر با Docker Compose اجرا می‌کنید: http://ollama:11434
OLLAMA_HOST=http://127.0.0.1:11434

# [مدل پیش‌فرض] نام مدلی که در Ollama دانلود کرده‌اید
# پیشنهادها:
# - qwen2.5:14b (تعادل عالی سرعت و هوش، پشتیبانی فوق‌العاده از فارسی و کدنویسی)
# - qwen2.5:7b (سبک‌تر برای سیستم‌های با رم پایین‌تر)
# - deepseek-r1:14b یا deepseek-r1:8b (مدل استدلالی بسیار قوی)
# - llama3.3:70b یا llama3.1:8b
MODEL_NAME=qwen2.5:14b

# [تنظیمات تولید متن]
# دمای تولید متن (بین 0.0 تا 1.0 - مقادیر بالاتر خلاقانه‌تر، مقادیر کمتر دقیق‌تر)
TEMPERATURE=0.7
# نمونه‌گیری top_p
TOP_P=0.9
# سقف توکن‌های پاسخ (برای یک LLM عمومی آزاد مقادیر بالا مثل 2048 یا 4096 مناسب است)
MAX_TOKENS=2048
# اندازه پنجره کانتکست (context window) در Ollama
NUM_CTX=8192
# مهلت پاسخگویی مدل به ثانیه (برای سیستم‌های محلی روی مدل‌های سنگین)
LLM_TIMEOUT=300
# مدت زمان آماده‌باش مدل در رم پس از آخرین درخواست (Keep Alive)
OLLAMA_KEEP_ALIVE=2h

# [تنظیمات حافظه گفتگو]
# حداکثر تعداد پیام‌های رفت و برگشتی نگه‌داری‌شده در تاریخچه چت هر کاربر
MAX_HISTORY_TURNS=15

# [شخصیت و پرامپت پیش‌فرض]
# گزینه‌ها: general, coder, creative, academic, concise
DEFAULT_PERSONA=general

# نمایش تفکر مدل‌های استدلالی (DeepSeek-R1 / Qwen3 Think tags)
# true = بخش <think> مدل به صورت بلوک نقل‌قول نمایش داده می‌شود
# false = بخش تفکر فیلتر شده و فقط پاسخ نهایی ارسال می‌شود
SHOW_THINKING=true

# [لاگ‌ها]
LOG_LEVEL=INFO

# ==============================================================================
# [اختیاری] تنظیمات کلاینت IRC (در صورت تمایل به اجرای بات روی شبکه IRC)
# ==============================================================================
IRC_ENABLED=false
IRC_SERVER=irc.libera.chat
IRC_PORT=6667
IRC_CHANNEL=#ai-chat
IRC_NICKNAME=IRCAIBot
